@model TerraSinal.Web.Models.ViewModels.RegisterViewModel
@{ ViewData["Title"] = "Criar conta · TERRA.SINAL"; Layout = null; }
<!doctype html>
<html lang="pt-MZ">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>@ViewData["Title"]</title>
  <link rel="icon" href="~/assets/img/favicon.svg" type="image/svg+xml">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link href="~/assets/css/style.css" rel="stylesheet">
</head>
<body>
<div class="auth-shell">
  <aside class="auth-aside">
    <div class="auth-logo">TERRA<b>.</b>SINAL<small>INTELIGÊNCIA DA PAISAGEM</small></div>
    <div class="auth-aside-copy">
      <span class="eyebrow">GRUPO 03 · SOFALA, MOÇAMBIQUE</span>
      <h1>Conhecer o território.<br><em>Decidir com evidência.</em></h1>
      <p>Monitoria de stress da vegetação com Copernicus NDVI, Sentinel-1 e CHIRPS para os distritos de Búzi e Muanza.</p>
    </div>
    <div class="auth-aside-foot">Autenticação com ASP.NET Core Identity · MySQL</div>
  </aside>
  <main class="auth-main">
    <div class="auth-card">
      <a class="auth-back" href="/"><i class="bi bi-arrow-left"></i> Voltar ao observatório</a>
      <span class="section-number">CONTA / CRIAR CONTA</span>
      <h2>Criar conta</h2>
      <p>Registo de investigador no observatório TERRA.SINAL</p>

      <form asp-action="Register" asp-controller="Account" method="post" autocomplete="on" aria-label="Criar conta">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2" style="font-size:.9rem"></div>

        <label asp-for="FullName">NOME COMPLETO</label>
        <input asp-for="FullName" class="form-control" placeholder="O seu nome" autofocus />
        <span asp-validation-for="FullName" class="text-danger" style="font-size:.8rem"></span>

        <label asp-for="Email" class="mt-2">EMAIL</label>
        <input asp-for="Email" class="form-control" placeholder="Email" />
        <span asp-validation-for="Email" class="text-danger" style="font-size:.8rem"></span>

        <label asp-for="Password" class="mt-2">PALAVRA-PASSE</label>
        <input asp-for="Password" class="form-control" placeholder="Mínimo 6 caracteres, com número" />
        <span asp-validation-for="Password" class="text-danger" style="font-size:.8rem"></span>

        <label asp-for="ConfirmPassword" class="mt-2">CONFIRMAR PALAVRA-PASSE</label>
        <input asp-for="ConfirmPassword" class="form-control" placeholder="Repetir palavra-passe" />
        <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size:.8rem"></span>

        <label asp-for="Role" class="mt-2">PERFIL</label>
        <select asp-for="Role" class="form-control">
          <option value="Investigador">Investigador — consulta e recomendações</option>
        </select>
        <span asp-validation-for="Role" class="text-danger" style="font-size:.8rem"></span>
        <small class="text-muted d-block mt-1">Contas de Administrador são criadas apenas por seed/admin.</small>

        <button type="submit" class="auth-disabled-btn mt-3" style="opacity:1;cursor:pointer;background:var(--accent,#2d6a4f);color:#fff;border:none">
          Criar conta <i class="bi bi-person-plus"></i>
        </button>
      </form>

      <p class="auth-swap">Já tem conta? <a href="/Account/Login">Iniciar sessão</a></p>
      <small class="auth-small">TERRA.SINAL · Identity + MySQL · 2026</small>
    </div>
  </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
