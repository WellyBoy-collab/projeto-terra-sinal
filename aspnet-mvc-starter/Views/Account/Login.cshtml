@model TerraSinal.Web.Models.ViewModels.LoginViewModel
@{ ViewData["Title"] = "Login · TERRA.SINAL"; Layout = null; }
<!doctype html>
<html lang="pt-MZ">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>@ViewData["Title"]</title>
  <link rel="icon" href="~/assets/img/favicon.svg" type="image/svg+xml">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="~/assets/css/style.css" asp-append-version="true">
</head>
<body>
<div class="auth-shell">
  <aside class="auth-aside">
    <div class="auth-logo">TERRA<b>.</b>SINAL<small>INTELIGÊNCIA DA PAISAGEM</small></div>
    <div class="auth-aside-copy">
      <span class="eyebrow">GRUPO 03 · SOFALA, MOÇAMBIQUE</span>
      <h1>Conhecer o território.<br><em>Decidir com evidência.</em></h1>
      <p>Monitoria de stress da vegetação com Copernicus NDVI, Sentinel-1 e CHIRPS para os distritos de Búzi e Muanza.</p>
    </div>
    
  </aside>
  <main class="auth-main">
    <div class="auth-card">
      <a class="auth-back" href="/"><i class="bi bi-arrow-left"></i> Voltar ao observatório</a>
      <span class="section-number">CONTA / INICIAR SESSÃO</span>
      <h2>Iniciar sessão</h2>
      <p>Acesso reservado aos utilizadores do observatório</p>

      <form asp-action="Login" asp-controller="Account" method="post" autocomplete="on" aria-label="Iniciar sessão">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2" style="font-size:.9rem"></div>
        <input type="hidden" asp-for="ReturnUrl" />

        <label asp-for="Email">EMAIL</label>
        <input asp-for="Email" class="form-control" placeholder="Email" autofocus />
        <span asp-validation-for="Email" class="text-danger" style="font-size:.8rem"></span>

        <label asp-for="Password" class="mt-2">PALAVRA-PASSE</label>
        <input asp-for="Password" class="form-control" placeholder="Palavra-passe" />
        <span asp-validation-for="Password" class="text-danger" style="font-size:.8rem"></span>

        <div class="form-check mt-3 mb-2">
          <input asp-for="RememberMe" class="form-check-input" />
          <label asp-for="RememberMe" class="form-check-label">Manter sessão neste dispositivo</label>
        </div>

        <button type="submit" class="auth-disabled-btn" style="opacity:1;cursor:pointer;background:var(--accent,#2d6a4f);color:#fff;border:none">
          Iniciar sessão <i class="bi bi-box-arrow-in-right"></i>
        </button>
      </form>

      <p class="auth-swap">Ainda não tem conta? <a href="/Account/Register">Criar conta</a></p>
   
    </div>
  </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
